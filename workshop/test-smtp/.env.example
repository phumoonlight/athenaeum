# Copy to .env and fill in.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Leave blank to auto-pick: true for port 465, false otherwise.
SMTP_SECURE=
SMTP_USER=you@example.com
# Gmail/Yahoo/Outlook: use an app password, not your account password.
SMTP_PASS=

# Optional. Defaults to SMTP_USER.
SMTP_FROM=
SMTP_TO=

# Set to true to dump the full SMTP conversation.
SMTP_DEBUG=false
